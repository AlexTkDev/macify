{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macify.app/schemas/deal.schema.json",
  "title": "Macify deal manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "appSlug",
    "discountPercent",
    "code",
    "startsAt",
    "endsAt"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "appSlug": { "type": "string", "minLength": 2, "maxLength": 90, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "discountPercent": { "type": "integer", "minimum": 1, "maximum": 100 },
    "code": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
    "startsAt": { "type": "string", "format": "date-time" },
    "endsAt": { "type": "string", "format": "date-time" }
  }
}
