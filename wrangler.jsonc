{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "macify-local",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "images": {
    "binding": "IMAGES"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "macify-local-media"
    }
  ],
  "vars": {
    "APP_ENV": "local",
    "CATALOG_REPOSITORY": "Beingpax/macify"
  },
  "limits": {
    "cpu_ms": 500
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "env": {
    "production": {
      "name": "macify",
      "images": {
        "binding": "IMAGES"
      },
      "vars": {
        "APP_ENV": "production",
        "CATALOG_REPOSITORY": "Beingpax/macify"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "macify-production-database",
          "database_id": "603417fc-1404-4bc4-830c-a0532cbeacac",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "macify-production-media"
        }
      ]
    }
  }
}
